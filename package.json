{
  "name": "zizhuj-memory-demo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "start": "vite --host 0.0.0.0",
    "pack:dist": "npm run build && powershell -NoProfile -Command \"Copy-Item '用户使用说明.txt' dist/'用户使用说明.txt' -Force; Copy-Item '双击打开-发布版.bat' dist/'双击打开-发布版.bat' -Force; Copy-Item local-server.cjs dist/local-server.cjs -Force; Compress-Archive -Path dist/* -DestinationPath zizhuj-demo-dist.zip -Force\""
  },
  "dependencies": {
    "katex": "^0.17.0",
    "lucide-react": "^1.24.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "oxlint": "^1.71.0",
    "typescript": "~6.0.2",
    "vite": "^8.1.4"
  }
}
